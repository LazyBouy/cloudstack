%%{init: {"flowchart": {"wrappingWidth": 300}, "themeVariables": {"edgeLabelBackground": "#FFFFFF"}}}%%
flowchart TB
    %% Module 01 palette: tenants indigo, hosts green, VMs blue; the stopped management server
    %% greyed. No note: its labels say "stopped" and "still running", and a note would move HQ out of the request frames' layout
    %% Lines: requests solid (greyed: nobody answers). The same layout as the request frames:
    %% HQ's lines to the kitchens are transparent, because it sends nothing while it's stopped
    classDef user fill:#E8EAF6,stroke:#3949AB,color:#1B1B1B
    classDef off fill:#EEEEEE,stroke:#9E9E9E,color:#616161
    classDef host fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
    classDef vm fill:#E3F2FD,stroke:#1565C0,color:#1B1B1B

    p["A researcher of Physics,<br/>a business (tenant)"]
    hq["HQ (management server):<br/>stopped"]
    subgraph k1["Kitchen (host) 1"]
        v1["Virtual brand (VM):<br/>still running"]
    end
    subgraph k2["Kitchen (host) 2"]
        v2["Virtual brand (VM):<br/>web-01, still running"]
    end
    subgraph k3["Kitchen (host) 3"]
        v3["Virtual brand (VM):<br/>still running"]
    end
    p -->|"asks for a new VM"| hq
    hq -->|"no instructions"| k1
    hq -->|"no instructions"| k2
    hq -->|"no instructions"| k3

    class p user
    class hq off
    class k1,k2,k3 host
    class v1,v2,v3 vm
    linkStyle 0 stroke:#BDBDBD,stroke-width:1.5px,color:#9E9E9E
    linkStyle 1 stroke:transparent,color:transparent
    linkStyle 2 stroke:transparent,color:transparent
    linkStyle 3 stroke:transparent,color:transparent
