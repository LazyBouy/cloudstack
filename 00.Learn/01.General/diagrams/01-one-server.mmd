%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart LR
    %% Module 01 palette: hosts and hypervisors green, VMs blue; notes white with a dashed grey border
    classDef host fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
    classDef vm fill:#E3F2FD,stroke:#1565C0,color:#1B1B1B
    classDef note fill:#FFFFFF,stroke:#9E9E9E,color:#424242,stroke-dasharray:4 3

    subgraph srv["One physical server"]
        direction TB
        vm1["VM: web server<br/>OS: Ubuntu"]
        vm2["VM: desktop<br/>OS: Windows"]
        vm3["VM: database server<br/>OS: Ubuntu"]
        hw["Real hardware<br/>CPUs, memory, disks, network card"]
        vm3 ~~~ hw
        vm2 ~~~ hw
        vm1 ~~~ hw
    end
    n1["Three computers in one box:<br/>each VM has its own<br/>operating system"]
    srv --- n1

    class srv,hw host
    class vm1,vm2,vm3 vm
    class n1 note
    linkStyle 3 stroke:#9E9E9E,stroke-width:1.5px
