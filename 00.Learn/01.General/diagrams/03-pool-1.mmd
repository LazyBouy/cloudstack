%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart TB
    %% Module 01 palette: tenants indigo, the management server orange, hosts green
    %% Lines: requests and instructions solid. Two frames share one layout: in frame 1,
    %% HQ and its lines are transparent, so nothing moves when they appear in frame 2
    classDef user fill:#E8EAF6,stroke:#3949AB,color:#1B1B1B
    classDef ms fill:#FFF3E0,stroke:#EF6C00,color:#1B1B1B
    classDef host fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
    classDef hidden fill:none,stroke:none,color:transparent

    p["Business (tenant):<br/>Physics"]
    b["Business (tenant):<br/>Biology"]
    hq["HQ<br/>(management server)"]
    k1["Kitchen (host) 1"]
    k2["Kitchen (host) 2"]
    k3["Kitchen (host) 3"]
    p --> hq
    b --> hq
    hq --> k1
    hq --> k2
    hq --> k3

    class p,b user
    class hq hidden
    class k1,k2,k3 host
    linkStyle 0 stroke:transparent
    linkStyle 1 stroke:transparent
    linkStyle 2 stroke:transparent
    linkStyle 3 stroke:transparent
    linkStyle 4 stroke:transparent
