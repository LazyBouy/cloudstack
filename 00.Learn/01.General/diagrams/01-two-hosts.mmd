%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart LR
    %% Module 01 palette: hosts and hypervisors green, VMs blue. No note here: a box between the two hosts would read as shared
    classDef host fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
    classDef vm fill:#E3F2FD,stroke:#1565C0,color:#1B1B1B

    subgraph ka["Kitchen (host) A"]
        direction TB
        va["Virtual brands (VMs)"]
        ea["A's own equipment<br/>(hypervisor: KVM)"]
        va ~~~ ea
    end
    subgraph kb["Kitchen (host) B"]
        direction TB
        vb["Virtual brands (VMs)"]
        eb["B's own equipment<br/>(hypervisor: KVM)"]
        vb ~~~ eb
    end
    ka ~~~ kb

    class ka,kb,ea,eb host
    class va,vb vm
