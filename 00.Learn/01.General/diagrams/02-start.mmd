%%{init: {"flowchart": {"wrappingWidth": 300}, "themeVariables": {"edgeLabelBackground": "#FFFFFF"}}}%%
%% render-scale: 1.5
flowchart TB
    %% Module 01 palette: people indigo, the hypervisor's parts green, VMs blue; notes white with a dashed grey border
    %% Lines: requests and instructions solid. Vertical, with short labels, so the text stays readable
    classDef user fill:#E8EAF6,stroke:#3949AB,color:#1B1B1B
    classDef host fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
    classDef vm fill:#E3F2FD,stroke:#1565C0,color:#1B1B1B
    classDef note fill:#FFFFFF,stroke:#9E9E9E,color:#424242,stroke-dasharray:4 3

    a["An admin"]
    lv["libvirt"]
    subgraph q["One QEMU process"]
        v["VM: web server (Ubuntu)"]
    end
    k["KVM, in the kernel"]
    a -->|"1. start the VM"| lv
    lv -->|"2. launches"| q
    q -->|"3. run its processors"| k
    n1["QEMU uses KVM,<br/>not the other way round"]
    k --- n1

    class a user
    class lv,q,k host
    class v vm
    class n1 note
    linkStyle 3 stroke:#9E9E9E,stroke-width:1.5px
