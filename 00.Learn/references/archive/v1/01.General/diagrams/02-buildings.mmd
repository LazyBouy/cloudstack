%%{init: {"flowchart": {"wrappingWidth": 340}}}%%
flowchart TB
    %% Palette shared by every picture of post 02 (head office, staff-only and site colours as in 01-hotel)
    classDef office fill:#FDF4FF,stroke:#E879F9,color:#28253D
    classDef back fill:#F0FDFA,stroke:#2DD4BF,color:#28253D
    classDef site fill:#FFF7ED,stroke:#FB923C,color:#28253D
    classDef floor fill:#ECFEFF,stroke:#22D3EE,color:#28253D
    classDef staff fill:#F0FDF4,stroke:#4ADE80,color:#28253D
    classDef store fill:#F5F3FF,stroke:#A78BFA,color:#28253D
    classDef building fill:#FEF2F2,stroke:#F87171,color:#28253D
    classDef wing fill:#F8FAFC,stroke:#64748B,color:#28253D
    classDef city fill:#FFFFFF,stroke:#94A3B8,color:#28253D
    classDef note fill:#FEFCE8,stroke:#CA8A04,color:#28253D,stroke-dasharray:4 3

    subgraph region["City (region 1)"]
        ho["Head office<br/>(management server)"]
        ledger[("Ledger<br/>(MySQL)")]
        subgraph zone["Hotel site (zone 1): usually one data centre"]
            wh[("Warehouse<br/>(secondary storage)")]
            subgraph pod["Building (pod 1): one rack, one subnet"]
                subgraph wa["Wing A (cluster A): one hypervisor type"]
                    sra[("Storage room<br/>(cluster-wide<br/>primary storage)")]
                    subgraph h1["Floor (host 1)"]
                        r1["Room (VM)"]
                    end
                    subgraph h2["Floor (host 2)"]
                        r2["Room (VM)"]
                        cup[("Cupboard<br/>(local primary storage)")]
                    end
                end
                subgraph wb["Wing B (cluster B)"]
                    subgraph h3["Floor (host 3)"]
                        r3["Room (VM)"]
                    end
                end
            end
            sitesr[("Site storage room<br/>(zone-wide primary<br/>storage, optional)")]
        end
    end
    region2["Another city (region 2):<br/>its own head office and ledger"]

    ho -.->|"records"| ledger
    wh -.->|"room styles copied in"| sra
    r1 -.->|"disks"| sra
    r2 -.->|"disks"| cup
    r3 -.->|"disks"| sitesr
    r1 -->|"can move while running<br/>(live migration)"| h2

    class ho office
    class ledger back
    class zone site
    class wh,sra,cup,sitesr store
    class pod building
    class wa,wb wing
    class h1,h2,h3 floor
    class region,region2 city
    linkStyle 0,2,3,4 stroke-dasharray:8 6,stroke-width:2px
    linkStyle 1 stroke-dasharray:2 4
