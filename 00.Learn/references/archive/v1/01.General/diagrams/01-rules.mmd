%%{init: {"flowchart": {"wrappingWidth": 340}}}%%
flowchart TB
    %% Palette shared with post 02 (head office, staff-only and site colours as in 01-hotel)
    classDef office fill:#FDF4FF,stroke:#E879F9,color:#28253D
    classDef back fill:#F0FDFA,stroke:#2DD4BF,color:#28253D
    classDef site fill:#FFF7ED,stroke:#FB923C,color:#28253D
    classDef floor fill:#ECFEFF,stroke:#22D3EE,color:#28253D
    classDef staff fill:#F0FDF4,stroke:#4ADE80,color:#28253D
    classDef store fill:#F5F3FF,stroke:#A78BFA,color:#28253D
    classDef note fill:#FEFCE8,stroke:#CA8A04,color:#28253D,stroke-dasharray:4 3

    dev["Developers<br/>(CloudStack's code)"]
    op["You, the operator<br/>(root admin)"]
    asha(["Asha<br/>(a user of your cloud)"])
    desk["Front desk<br/>(API)"]
    ledger[("Ledger: the global setting<br/>max.account.user.vms = 20")]
    n1["Root admins are never<br/>limited: you won't hit the 20"]
    dev -->|"wrote the default<br/>(copied in on first start)"| ledger
    op -->|"changes it: Global Settings,<br/>or one account's own limit"| ledger
    asha -->|"asks for a 21st VM"| desk
    desk -.->|"checks the limit"| ledger
    asha <-.->|"refused: limit reached"| desk
    op -.- n1

    class ledger back
    class desk office
    class n1 note
    linkStyle 3 stroke-dasharray:8 6,stroke-width:2px
    linkStyle 4 stroke-dasharray:2 4,marker-end:none
    linkStyle 5 stroke:#CA8A04,stroke-width:1.5px,stroke-dasharray:3 3
